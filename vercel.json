{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "BakeHub/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(verify-otp-mock|verify-otp-firebase|get_orders.php|place_order.php|get_user_data.php|profile_actions.php|api/config)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "BakeHub/$1"
    }
  ]
}
